    "tStartMs": 1087520,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "video and I'll show you\n\u003e\u003e [music]"
    } ]
  }, {
    "tStartMs": 1088640,
    "dDurationMs": 7640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e the exact decision system that tells you\nwhat to do even when the answer is not",
