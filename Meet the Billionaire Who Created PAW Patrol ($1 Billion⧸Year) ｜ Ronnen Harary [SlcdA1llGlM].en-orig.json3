    "tStartMs": 378880,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "year before Anton, my business partner,\nwas backpacking in Europe, and he met"
    } ]
  }, {
    "tStartMs": 382200,
    "dDurationMs": 7320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "this guy by the name of Aaron Hermelin.\nAnd Aaron Hermelin's father father owned"
