  }, {
    "tStartMs": 425960,
    "dDurationMs": 4720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "pitch, he says to me, \"I'm not the buyer\nfor this product.\""
    } ]
  }, {
    "tStartMs": 428960,
    "dDurationMs": 4640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "And I, you know, when I was your age, I\nwas slightly a little bit paranoid, so I"
    } ]
  }, {
    "tStartMs": 432160,
    "dDurationMs": 4920,
    "wWinId": 1,
    "segs": [ {
