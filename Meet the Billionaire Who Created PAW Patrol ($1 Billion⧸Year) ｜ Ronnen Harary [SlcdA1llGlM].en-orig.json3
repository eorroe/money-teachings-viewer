    } ]
  }, {
    "tStartMs": 373680,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "you actually get into Kmart? Like, what\ndid What is that What's the story behind"
    } ]
  }, {
