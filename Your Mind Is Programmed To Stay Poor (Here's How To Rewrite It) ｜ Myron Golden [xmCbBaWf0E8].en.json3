    "dDurationMs": 5680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "is giving an illustration of how\nsalvation, biblical salvation, works."
    } ]
  }, {
    "tStartMs": 2953720,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\"Let the little children come unto me.\"\nSo, what does a child do to provide for"
