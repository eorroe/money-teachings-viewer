    } ]
  }, {
    "tStartMs": 1713600,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "would sell them for $5\n\u003e\u003e Wow."
    } ]
  }, {
    "tStartMs": 1715240,
    "dDurationMs": 5960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e at the end of the services. So So So\nwhat happened was I didn't have a goal.",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1719360,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "I just like This church invited me to\ncome speak. And they wanted me to come"
    } ]
  }, {
