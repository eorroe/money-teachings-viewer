    "dDurationMs": 6040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "experiences, so my body would slow down,\nso my mind could speed up."
    } ]
  }, {
    "tStartMs": 2671120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Oh my gosh.\n\u003e\u003e That's good.",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2673085,
    "dDurationMs": 5595,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e [laughter]\n\u003e\u003e But that's the the the belief you've",
