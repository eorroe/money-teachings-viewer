    "dDurationMs": 2240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "anything I want to be.\n\u003e\u003e Really?"
    } ]
  }, {
    "tStartMs": 3463320,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Yeah. Um\n\u003e\u003e That's good.",
