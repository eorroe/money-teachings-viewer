  }, {
    "tStartMs": 2522960,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Wow.\n\u003e\u003e [snorts]",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2523960,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Like you you go to the gym. You work\nout. I can tell you have muscles, right?",
