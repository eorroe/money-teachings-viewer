    } ]
  }, {
    "tStartMs": 3501720,
    "dDurationMs": 4760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e in our in our family in our family\ndynamics, for sure.",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3504800,
    "dDurationMs": 4400,
    "wWinId": 1,
    "segs": [ {
