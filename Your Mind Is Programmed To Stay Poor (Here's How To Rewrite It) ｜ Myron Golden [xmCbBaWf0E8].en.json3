    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "heaven.\" Now, what does that mean?\n\u003e\u003e I'm sorry."
    } ]
  }, {
    "tStartMs": 2917160,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "What does that mean and how should we\ninterpret that?"
