    "wWinId": 1,
    "segs": [ {
      "utf8": "So, I couldn't run, but what it did is\nit caused me to be hyper-observant."
    } ]
  }, {
    "tStartMs": 2721160,
    "dDurationMs": 1960,
    "wWinId": 1,
