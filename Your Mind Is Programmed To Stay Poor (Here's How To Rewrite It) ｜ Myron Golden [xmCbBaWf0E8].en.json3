    "wWinId": 1,
    "segs": [ {
      "utf8": "fight with him.\n\u003e\u003e Wow."
    } ]
  }, {
    "tStartMs": 3493480,
    "dDurationMs": 4280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e So we learned team dynamic in our\nfamily.",
