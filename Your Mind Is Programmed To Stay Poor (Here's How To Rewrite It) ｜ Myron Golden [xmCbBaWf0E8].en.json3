    "tStartMs": 2919080,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Well, what it actually means, and you\ncan't First of all, I'm going to say",
      "isSpeakerChange": 1
    } ]
