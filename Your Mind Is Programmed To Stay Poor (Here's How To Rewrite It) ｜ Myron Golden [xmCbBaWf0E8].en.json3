  }, {
    "tStartMs": 2960320,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "cries, I guess, for\n\u003e\u003e But does it earn money? It's a crying"
    } ]
  }, {
    "tStartMs": 2963320,
    "dDurationMs": 2640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e No, to provide, no, it doesn't make any\nmoney.",
