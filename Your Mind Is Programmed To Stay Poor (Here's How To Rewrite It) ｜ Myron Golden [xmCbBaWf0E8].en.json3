    } ]
  }, {
    "tStartMs": 3464880,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Yeah, that's uh I had\n\u003e\u003e That's wealth.",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3466840,
    "dDurationMs": 5280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e That's wealth beyond measure. Right?\nI've got six brothers, one older",
