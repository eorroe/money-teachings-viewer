    "dDurationMs": 2920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e So it's like a sport.\n\u003e\u003e It was.",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3499800,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e You're a professional athlete in your\nfamily.",
