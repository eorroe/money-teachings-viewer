  }, {
    "tStartMs": 2706840,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "how to make something that could help me\nrun."
    } ]
  }, {
    "tStartMs": 2709560,
    "dDurationMs": 5320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Right? Because I always wanted to run.\nBecause"
    } ]
  }, {
    "tStartMs": 2713520,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "I just tell people I couldn't run, so I\nlearned how to fight."
    } ]
  }, {
    "tStartMs": 2717000,
