  }, {
    "tStartMs": 2348120,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "I said, \"Well, you're a schmuck if you\ndid an IRA in a 27% in 13 state you"
    } ]
  }, {
    "tStartMs": 2353840,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "would only pay two.\" You mean they're\ngoing to give me 3,000 back? No, you're"
    } ]
  }, {
    "tStartMs": 2358240,
    "dDurationMs": 7080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "not going to pay it. The IRA comes off\nyour gross earnings, right off the top."
