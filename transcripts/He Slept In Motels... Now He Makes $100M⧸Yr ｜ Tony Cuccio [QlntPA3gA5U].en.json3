    "dDurationMs": 8760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "every 2 weeks, very little amount.\nOne girl's with me 25 years, she's a"
    } ]
  }, {
    "tStartMs": 2300040,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Mexican girl, she has $200,000 in it.\nIf I didn't start that IRA for 20 years,"
