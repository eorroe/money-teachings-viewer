    "tStartMs": 2312840,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "under 250 grand, it's a Roth IRA. Roth's\nare unbelievable."
    } ]
  }, {
    "tStartMs": 2317760,
    "dDurationMs": 7240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "They don't charge you interest on the\nmoney you make till you're 65. And when"
