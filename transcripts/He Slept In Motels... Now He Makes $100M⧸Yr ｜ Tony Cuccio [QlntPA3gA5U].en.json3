  }, {
    "tStartMs": 2277520,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "don't have IRAs.\nHow could you not have an IRA?"
    } ]
  }, {
    "tStartMs": 2281120,
    "dDurationMs": 8080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "How could you not have a Roth? I have\n200 employees. I've started 90 IRAs for"
