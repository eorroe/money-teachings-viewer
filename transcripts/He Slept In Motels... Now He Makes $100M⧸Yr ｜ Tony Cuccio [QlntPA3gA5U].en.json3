    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "33 million."
    } ]
  }, {
    "tStartMs": 3870560,
    "dDurationMs": 5400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "So, the guy who wrote the book went back\n25 generations"
