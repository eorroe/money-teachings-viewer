    "wWinId": 1,
    "segs": [ {
      "utf8": "that you have to change. Like platforms\nnow. We only sold professional salons."
    } ]
  }, {
    "tStartMs": 1087840,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "If I stayed in the salon business, I\nwould be broke. Once Amazon came out,"
