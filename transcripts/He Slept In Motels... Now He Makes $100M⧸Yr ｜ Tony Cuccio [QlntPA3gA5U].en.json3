    } ]
  }, {
    "tStartMs": 3819120,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Yeah, this this is a this is a good one\nfor everybody.",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3822760,
    "dDurationMs": 5080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "I don't care whether you're Jewish, I\ndon't care whether you're Catholic,"
