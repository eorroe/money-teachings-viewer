    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "that help you or did that hurt you\nultimately?"
    } ]
  }, {
    "tStartMs": 1070040,
    "dDurationMs": 7240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "I think in the beginning\nthey perceived it as being not a good"
