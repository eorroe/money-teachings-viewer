  }, {
    "tStartMs": 3846840,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "your daughter or your son.\nSo, religion is a big word."
    } ]
  }, {
    "tStartMs": 3851960,
    "dDurationMs": 6200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Okay, and I'll give you this statistic\nwhich will really make you think."
    } ]
  }, {
    "tStartMs": 3855680,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Okay, if we took you three gentlemen and\nme and we went back 25 generations and"
    } ]
  }, {
