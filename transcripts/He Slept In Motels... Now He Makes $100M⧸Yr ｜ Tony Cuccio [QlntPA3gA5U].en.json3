  }, {
    "tStartMs": 2339840,
    "dDurationMs": 4720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "used to tell my girls that work for me,\n\"Are you a schmuck?"
    } ]
  }, {
    "tStartMs": 2342920,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "How much money did you pay last year in\ntaxes?\" Well, I only paid $5,000."
