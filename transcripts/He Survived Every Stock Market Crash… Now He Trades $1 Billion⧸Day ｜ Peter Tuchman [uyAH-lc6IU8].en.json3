    "tStartMs": 57920,
    "dDurationMs": 5680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "What's going on everyone? Welcome back\nto the School of Hard Knocks podcast.",
      "acAsrConf": 0
    } ]
