    "tStartMs": 61359,
    "dDurationMs": 5601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "I'm James. I'm here with Jack and Josh.\nAnd we have an incredible guest for you",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 65840,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "all right now. My good [clears throat]\nfriend Peter Tuckman, otherwise known as",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 69119,
    "dDurationMs": 6801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "the Einstein of Wall Street. He is the\nlongest ever standing trader on the",
      "acAsrConf": 0
    } ]
