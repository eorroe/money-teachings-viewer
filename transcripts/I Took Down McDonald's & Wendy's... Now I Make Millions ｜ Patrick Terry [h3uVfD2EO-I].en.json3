  }, {
    "tStartMs": 9440,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "milkshakes, I just am attracted to that.\n\u003e\u003e started P. Terry's in your late 40s."
    } ]
  }, {
    "tStartMs": 13160,
    "dDurationMs": 7560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Yeah. Across the street, the day we\nopened was McDonald's, Jack in the Box,",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 17600,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Wendy's, Taco Cabana, Taco Bell, and\nSchlotzsky's."
    } ]
  }, {
    "tStartMs": 21560,
    "dDurationMs": 2200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Not a single one of those are still\nthere.",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 22920,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e They're all gone.\n\u003e\u003e Why did all those places go? Do you know",
