  }, {
    "tStartMs": 74400,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "I'm going to put it out there, these\n[laughter] are some These are some It's"
    } ]
  }, {
    "tStartMs": 76920,
    "dDurationMs": 5200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "the truth. These are some damn good\nhamburgers."
    } ]
  }, {
    "tStartMs": 80240,
    "dDurationMs": 5680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "And um, you know, we're just super happy\nto be here with you today, my friend."
