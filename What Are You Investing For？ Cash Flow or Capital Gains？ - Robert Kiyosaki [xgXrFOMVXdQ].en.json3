  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "(energetic rock music)"
    } ]
  }, {
    "tStartMs": 6600,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "- But this is investing 101, I mean,"
    } ]
  }, {
    "tStartMs": 9120,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "there's fundamental and\ntechnical, you know?"
    } ]
  }, {
    "tStartMs": 12250,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Cashflow 101 is fundamental,"
    } ]
  }, {
    "tStartMs": 14730,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Cashflow 202 is technical investing, okay?"
    } ]
  }, {
    "tStartMs": 19050,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "So, there's two basic investments."
    } ]
  }, {
    "tStartMs": 22800,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "One is cashflow."
    } ]
  }, {
    "tStartMs": 27530,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And as Kenny already said,"
    } ]
  }, {
    "tStartMs": 29900,
    "dDurationMs": 1213,
    "segs": [ {
      "utf8": "this is the hardest."
    } ]
  }, {
    "tStartMs": 32810,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "It is the hardest to find"
    } ]
  }, {
    "tStartMs": 36150,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "because cashflow then\naffects return on investment."
    } ]
  }, {
    "tStartMs": 39480,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "So if I put in $10 and\nI get one dollar back,"
    } ]
  }, {
    "tStartMs": 43300,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "that's a 10% ROI, okay?"
    } ]
  }, {
    "tStartMs": 46610,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "I mean, it's just simple."
    } ]
  }, {
    "tStartMs": 49480,
    "dDurationMs": 3590,
    "segs": [ {
      "utf8": "I mean, I was taught this\nas a kid playing Monopoly."
    } ]
  }, {
    "tStartMs": 53070,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "You know, you got one house, you get $18,"
    } ]
  }, {
    "tStartMs": 55130,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "you get two houses, you got $36,"
    } ]
  }, {
    "tStartMs": 56710,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "I mean it's not,"
    } ]
  }, {
    "tStartMs": 57820,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "you don't have to go to college."
    } ]
  }, {
    "tStartMs": 59200,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "It is not that hard."
    } ]
  }, {
    "tStartMs": 60550,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Monopoly is a cashflow game, right?"
    } ]
  }, {
    "tStartMs": 62570,
    "dDurationMs": 970,
    "segs": [ {
      "utf8": "And that's it."
    } ]
  }, {
    "tStartMs": 63540,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "- Yeah, and the problem is,"
    } ]
  }, {
    "tStartMs": 66220,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "is that the people that you're\nseeing in the paper today,"
    } ]
  }, {
    "tStartMs": 70440,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "their philosophy is not\nbased on this, period."
    } ]
  }, {
    "tStartMs": 73300,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "- No.\n- It isn't."
    } ]
  }, {
    "tStartMs": 74430,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "- But they don't, I mean,\nthis is as simple as it gets."
    } ]
  }, {
    "tStartMs": 78170,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Technical, fundamental,\ncashflow versus capital gains."
    } ]
  }, {
    "tStartMs": 86880,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "I mean, you know,"
    } ]
  }, {
    "tStartMs": 90010,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "if you play Monopoly,\nyou'll understand this game."
    } ]
  }, {
    "tStartMs": 92730,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "This is all there is,"
    } ]
  }, {
    "tStartMs": 94060,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "so when you look at cashflow 101,"
    } ]
  }, {
    "tStartMs": 96130,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "this is called fundamental,"
    } ]
  }, {
    "tStartMs": 103550,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "and this is called technical."
    } ]
  }, {
    "tStartMs": 107940,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And the reason it's technical\n'cause it's all emotion."
    } ]
  }, {
    "tStartMs": 110820,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "It's up or down, up or down, up or down,"
    } ]
  }, {
    "tStartMs": 113450,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "as Kenny says, what's your net worth?"
    } ]
  }, {
    "tStartMs": 115670,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "What's your equity?"
    } ]
  }, {
    "tStartMs": 116580,
    "dDurationMs": 3023,
    "segs": [ {
      "utf8": "It depends upon the emotions of that time."
    } ]
  }, {
    "tStartMs": 120510,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "So, I mean, these morons\nhaven't got their lesson yet,"
    } ]
  }, {
    "tStartMs": 122730,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "they're going in to buy a foreclosure"
    } ]
  }, {
    "tStartMs": 124610,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "that was here to go on the same\nthing, I got one more time."
    } ]
  }, {
    "tStartMs": 127840,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "- Well yeah, and here's the ironic thing"
    } ]
  }, {
    "tStartMs": 130450,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "is that all these people\nthat're losing everything,"
    } ]
  }, {
    "tStartMs": 133460,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "they're gonna blame it on\nthe real estate market."
    } ]
  }, {
    "tStartMs": 135320,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "- [Robert] Yep."
    } ]
  }, {
    "tStartMs": 136940,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "- They're not gonna take\nownership of the issue."
    } ]
  }, {
    "tStartMs": 139720,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "They are gonna blame it on the market."
    } ]
  }, {
    "tStartMs": 142270,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And at this time, I'm\nmaking so much more money"
    } ]
  }, {
    "tStartMs": 147360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "than I was two years ago."
    } ]
  }, {
    "tStartMs": 149600,
    "dDurationMs": 1555,
    "segs": [ {
      "utf8": "- Lemme ask you this,"
    } ]
  }, {
    "tStartMs": 151155,
    "dDurationMs": 935,
    "segs": [ {
      "utf8": "you just built your house, right?"
    } ]
  }, {
    "tStartMs": 152090,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Kenny] Yeah."
    } ]
  }, {
    "tStartMs": 152923,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "- 'Kay, and Kenny has owned multi,"
    } ]
  }, {
    "tStartMs": 155990,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "multi, multimillion dollar properties,"
    } ]
  }, {
    "tStartMs": 158810,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "but only after he was a rich\nman did he build a house."
    } ]
  }, {
    "tStartMs": 163010,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "And what poor people do\nis they buy the big house"
    } ]
  }, {
    "tStartMs": 166760,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "on emotion, technical,"
    } ]
  }, {
    "tStartMs": 169050,
    "dDurationMs": 2213,
    "segs": [ {
      "utf8": "and then they never buy on cashflow."
    } ]
  }, {
    "tStartMs": 172420,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "That is a, you know,"
    } ]
  }, {
    "tStartMs": 173430,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "oh, I have the house of my dreams!"
    } ]
  }, {
    "tStartMs": 176740,
    "dDurationMs": 1573,
    "segs": [ {
      "utf8": "What a frickin' loser, are you!"
    } ]
  }, {
    "tStartMs": 179460,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "How stupid can you be?"
    } ]
  }, {
    "tStartMs": 182280,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "Kim and I live in a tiny little\nhouse on 16th Street here."
    } ]
  }, {
    "tStartMs": 187384,
    "dDurationMs": 2796,
    "segs": [ {
      "utf8": "We paid $117,000 for it,"
    } ]
  }, {
    "tStartMs": 192320,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "monthly payments were $300 a month,"
    } ]
  }, {
    "tStartMs": 193720,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "including homeowners' association,"
    } ]
  }, {
    "tStartMs": 195080,
    "dDurationMs": 1518,
    "segs": [ {
      "utf8": "who were rippin' us off."
    } ]
  }, {
    "tStartMs": 196598,
    "dDurationMs": 1342,
    "segs": [ {
      "utf8": "(audience laughing)"
    } ]
  }, {
    "tStartMs": 197940,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Oh no, they were the, homeowners\nare the biggest crooks"
    } ]
  }, {
    "tStartMs": 200200,
    "dDurationMs": 1248,
    "segs": [ {
      "utf8": "I've ever met in my life."
    } ]
  }, {
    "tStartMs": 201448,
    "dDurationMs": 1442,
    "segs": [ {
      "utf8": "(laughing)"
    } ]
  }, {
    "tStartMs": 202890,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "Homeowner means crooks."
    } ]
  }, {
    "tStartMs": 204950,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "That's what it means,\nthey're the biggest crooks"
    } ]
  }, {
    "tStartMs": 206860,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "I've ever met in my whole life."
    } ]
  }, {
    "tStartMs": 208690,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "Nice, honest people, you know?"
    } ]
  }, {
    "tStartMs": 209720,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Like, frick it!\n(laughing)"
    } ]
  }, {
    "tStartMs": 210820,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "As they come, they are ripping you,"
    } ]
  }, {
    "tStartMs": 212530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "stealing from you, and all this stuff."
    } ]
  }, {
    "tStartMs": 214720,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "But we sat there and we bought cashflow"
    } ]
  }, {
    "tStartMs": 217500,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "and our little house just sat there"
    } ]
  }, {
    "tStartMs": 218950,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and it sat there and it sat there,"
    } ]
  }, {
    "tStartMs": 220390,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "one of those dinky little house."
    } ]
  }, {
    "tStartMs": 222610,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "One day, we popped up and\nwe had a lot of money."
    } ]
  }, {
    "tStartMs": 225710,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "Then we bought a big house."
    } ]
  }, {
    "tStartMs": 227380,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "The same as Kenny."
    } ]
  }, {
    "tStartMs": 229150,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "If you can understand\nwhat we're saying to you,"
    } ]
  }, {
    "tStartMs": 231340,
    "dDurationMs": 2423,
    "segs": [ {
      "utf8": "it's just fundamental of rich people."
    } ]
  }, {
    "tStartMs": 234690,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And poor people want the big house,"
    } ]
  }, {
    "tStartMs": 236610,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "the BMW, the nice cars and all this stuff,"
    } ]
  }, {
    "tStartMs": 239300,
    "dDurationMs": 3013,
    "segs": [ {
      "utf8": "but they don't have the\ncashflow to support this."
    } ]
  }, {
    "tStartMs": 243660,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Do I make sense to you guys here?"
    } ]
  }, {
    "tStartMs": 245610,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "That's the difference."
    } ]
  }, {
    "tStartMs": 247060,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- One other thing I wanted to add is"
    } ]
  }, {
    "tStartMs": 250080,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "I happened to be in Calgary two weeks ago."
    } ]
  }, {
    "tStartMs": 253380,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And Calgary just as a city\nappreciated 50% last year,"
    } ]
  }, {
    "tStartMs": 258660,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "so when the--\n- Wait,"
    } ]
  }, {
    "tStartMs": 259493,
    "dDurationMs": 2397,
    "segs": [ {
      "utf8": "why is Calgary appreciating right now?"
    } ]
  }, {
    "tStartMs": 261890,
    "dDurationMs": 1183,
    "segs": [ {
      "utf8": "- Anybody?"
    } ]
  }, {
    "tStartMs": 263073,
    "dDurationMs": 1737,
    "segs": [ {
      "utf8": "- Oil.\n- Oil."
    } ]
  }, {
    "tStartMs": 264810,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "- Why do we just buy in Oklahoma?"
    } ]
  }, {
    "tStartMs": 267070,
    "dDurationMs": 1073,
    "segs": [ {
      "utf8": "- Yeah, oil.\n- Oil."
    } ]
  }, {
    "tStartMs": 269000,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "I mean, wherever there's\njobs, you buy real estate."
    } ]
  }, {
    "tStartMs": 272940,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "Why am I not buying in Michigan?"
    } ]
  }, {
    "tStartMs": 274910,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "General Motors.\n(audience laughing)"
    } ]
  }, {
    "tStartMs": 277850,
    "dDurationMs": 1004,
    "segs": [ {
      "utf8": "No oil!"
    } ]
  }, {
    "tStartMs": 278854,
    "dDurationMs": 1526,
    "segs": [ {
      "utf8": "- Yeah, in Japan.\n- Yeah, Japan."
    } ]
  }, {
    "tStartMs": 280380,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "- But, what's interesting is,"
    } ]
  }, {
    "tStartMs": 283400,
    "dDurationMs": 1070,
    "segs": [ {
      "utf8": "is that whenever I do a talk,"
    } ]
  }, {
    "tStartMs": 284470,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "I always like to start\nout and ask, you know,"
    } ]
  }, {
    "tStartMs": 286060,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "how many flippers are in a room"
    } ]
  }, {
    "tStartMs": 287230,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "and there's probably 200.\n(laughing)"
    } ]
  }, {
    "tStartMs": 289910,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And I said, okay, I go--\n(birdcall)"
    } ]
  }, {
    "tStartMs": 292460,
    "dDurationMs": 2246,
    "segs": [ {
      "utf8": "You know, I said, how\nmany people are flippers?"
    } ]
  }, {
    "tStartMs": 294706,
    "dDurationMs": 2894,
    "segs": [ {
      "utf8": "And 200 people raised\ntheir hand and I said,"
    } ]
  }, {
    "tStartMs": 297600,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "how many people wish they\nwouldn't have flipped a year ago?"
    } ]
  }, {
    "tStartMs": 300270,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "200 people raised their hand."
    } ]
  }, {
    "tStartMs": 302030,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "So, the point is,"
    } ]
  }, {
    "tStartMs": 303600,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "it doesn't matter if the market's going up"
    } ]
  }, {
    "tStartMs": 305750,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "or the market's going down."
    } ]
  }, {
    "tStartMs": 307470,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "It's a bad strategy because they,"
    } ]
  }, {
    "tStartMs": 310500,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "those people, those 200 people,"
    } ]
  }, {
    "tStartMs": 312660,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "would have had another 50% in\nvalue based on appreciation"
    } ]
  }, {
    "tStartMs": 316830,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "If they would've not flipped."
    } ]
  }, {
    "tStartMs": 319490,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "So, it doesn't matter\nif the market's going up"
    } ]
  }, {
    "tStartMs": 323330,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "or the market's going down."
    } ]
  }, {
    "tStartMs": 325340,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "You might be able to time a\nquick buck here and there,"
    } ]
  }, {
    "tStartMs": 328000,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "no question, but the truth is,"
    } ]
  }, {
    "tStartMs": 329710,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "people that flipped in Phoenix\nin '03 lost 70, 80% in value."
    } ]
  }, {
    "tStartMs": 335210,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "If they still would've owned the home,"
    } ]
  }, {
    "tStartMs": 337013,
    "dDurationMs": 2477,
    "segs": [ {
      "utf8": "they would've owned it for a lot less"
    } ]
  }, {
    "tStartMs": 339490,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "and it would be cashflow now,"
    } ]
  }, {
    "tStartMs": 340660,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "'cause now what's happening\nis rents are screamin'."
    } ]
  }, {
    "tStartMs": 343520,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "Rents are going up dramatically."
    } ]
  }, {
    "tStartMs": 346960,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "- And populations, you know,"
    } ]
  }, {
    "tStartMs": 349150,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Phoenix is still the number\none or number two growth,"
    } ]
  }, {
    "tStartMs": 351430,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "Arizona's number one or two\ngrowth state in the nation."
    } ]
  }, {
    "tStartMs": 354650,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "As the Baby Boomers retire"
    } ]
  }, {
    "tStartMs": 356130,
    "dDurationMs": 2517,
    "segs": [ {
      "utf8": "and the hurricanes hit Florida,\nmore come here, you know?"
    } ]
  }, {
    "tStartMs": 358647,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "And it's just fundamentals."
    } ]
  }, {
    "tStartMs": 361080,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "This is called demographics,"
    } ]
  }, {
    "tStartMs": 362500,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "and that's why I show you this here."
    } ]
  }, {
    "tStartMs": 364380,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "A nation of 300 million in 10,\n15 years will be 350 million."
    } ]
  }, {
    "tStartMs": 368530,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "They gotta live somewhere."
    } ]
  }, {
    "tStartMs": 370830,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And the dollar's gonna keep dropping,"
    } ]
  }, {
    "tStartMs": 373390,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "the price of oil will keep going up,"
    } ]
  }, {
    "tStartMs": 375250,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "gold will keep going up,"
    } ]
  }, {
    "tStartMs": 376610,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "silver will keep going up,"
    } ]
  }, {
    "tStartMs": 378460,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and replacement costs will keep goin' up."
    } ]
  }, {
    "tStartMs": 380650,
    "dDurationMs": 1827,
    "segs": [ {
      "utf8": "So these flippers got f'd."
    } ]
  }, {
    "tStartMs": 383640,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "It is really stupid, these guys here,"
    } ]
  }, {
    "tStartMs": 387820,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "you know, so for Kim and I,"
    } ]
  }, {
    "tStartMs": 389090,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "our strategy wasn't to own one big house."
    } ]
  }, {
    "tStartMs": 392700,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "Our strategy was to own 20 houses,"
    } ]
  }, {
    "tStartMs": 395750,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "then we live in a little house."
    } ]
  }, {
    "tStartMs": 398020,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "And then we went to 500,\nthen we bought a big house."
    } ]
  }, {
    "tStartMs": 402840,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "That is the difference between\nrich people and poor people."
    } ]
  }, {
    "tStartMs": 405650,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Poor people wanna look rich,"
    } ]
  }, {
    "tStartMs": 407490,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "and rich people wanna be rich, right?"
    } ]
  }, {
    "tStartMs": 410240,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "- Yeah, I mean, it's the same thing."
    } ]
  }, {
    "tStartMs": 412310,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Any money that I had, I put\ninto real estate investment."
    } ]
  }, {
    "tStartMs": 417610,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "And because that's what I do,"
    } ]
  }, {
    "tStartMs": 419090,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "so I obviously could have\nput that into my home or,"
    } ]
  }, {
    "tStartMs": 423500,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "you know, or cars and all\nthose kinds of things."
    } ]
  }, {
    "tStartMs": 425390,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "I could have brought all those things."
    } ]
  }, {
    "tStartMs": 426950,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "In the cashflow game,\nthose are called doodads."
    } ]
  }, {
    "tStartMs": 430450,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "But I didn't."
    } ]
  }, {
    "tStartMs": 431990,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "You know, I continued to pour all money,"
    } ]
  }, {
    "tStartMs": 434730,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "and we always joke around"
    } ]
  }, {
    "tStartMs": 436400,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "'cause we're literally always broke"
    } ]
  }, {
    "tStartMs": 438840,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "because if we have money--\n(audience laughing)"
    } ]
  }, {
    "tStartMs": 441410,
    "dDurationMs": 887,
    "segs": [ {
      "utf8": "- [Robert] What, wait,\nI want you to know--"
    } ]
  }, {
    "tStartMs": 442297,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "- It's the truth.\n- How true,"
    } ]
  }, {
    "tStartMs": 444490,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Kim and I right now are cash strapped."
    } ]
  }, {
    "tStartMs": 449200,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "We have no cash."
    } ]
  }, {
    "tStartMs": 451450,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "I mean, we are so tapped out,"
    } ]
  }, {
    "tStartMs": 453140,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "the reason is is because we're\ninvesting like wild people."
    } ]
  }, {
    "tStartMs": 458028,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Do you know what I mean?"
    } ]
  }, {
    "tStartMs": 458861,
    "dDurationMs": 2379,
    "segs": [ {
      "utf8": "I don't have savings, I don't have jack."
    } ]
  }, {
    "tStartMs": 461240,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "We have a lot of assets,\na lot of cashflow,"
    } ]
  }, {
    "tStartMs": 463710,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "but that money just keeps going back out."
    } ]
  }, {
    "tStartMs": 465580,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "It doesn't stay with us."
    } ]
  }, {
    "tStartMs": 467120,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "Your first investment, was\nit cashflow or capital gains?"
    } ]
  }, {
    "tStartMs": 469786,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Here, you're fine."
    } ]
  }, {
    "tStartMs": 470619,
    "dDurationMs": 4101,
    "segs": [ {
      "utf8": "- Okay, my first investment was cashflow."
    } ]
  }, {
    "tStartMs": 474720,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "- Why?"
    } ]
  }, {
    "tStartMs": 476180,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- Because I wanted that money coming in,"
    } ]
  }, {
    "tStartMs": 477740,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "my biggest concern is I\nwas gonna put money out"
    } ]
  }, {
    "tStartMs": 479610,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and not have anything coming back in."
    } ]
  }, {
    "tStartMs": 481350,
    "dDurationMs": 1537,
    "segs": [ {
      "utf8": "- And how much was your first cashflow?"
    } ]
  }, {
    "tStartMs": 482887,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "- $25 a month."
    } ]
  }, {
    "tStartMs": 484437,
    "dDurationMs": 1058,
    "segs": [ {
      "utf8": "(audience awws)"
    } ]
  }, {
    "tStartMs": 485495,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "But it was a start!"
    } ]
  }, {
    "tStartMs": 486328,
    "dDurationMs": 1482,
    "segs": [ {
      "utf8": "But it was a start, and I learned so much"
    } ]
  }, {
    "tStartMs": 487810,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "on that one property, but it did cashflow."
    } ]
  }, {
    "tStartMs": 490170,
    "dDurationMs": 2888,
    "segs": [ {
      "utf8": "- And how much cashflow\ndo you have a month now?"
    } ]
  }, {
    "tStartMs": 493058,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- Oh, about $120,000 a month."
    } ]
  }, {
    "tStartMs": 500207,
    "dDurationMs": 3686,
    "segs": [ {
      "utf8": "(audience applauding)"
    } ]
  }, {
    "tStartMs": 503893,
    "dDurationMs": 1594,
    "segs": [ {
      "utf8": "- That's not Donald\nTrump's money, you know,"
    } ]
  }, {
    "tStartMs": 505487,
    "dDurationMs": 2123,
    "segs": [ {
      "utf8": "that's not Warren Buffett's\nmoney and all this,"
    } ]
  }, {
    "tStartMs": 507610,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "but $120,000 a month is more\nthan most people make a year."
    } ]
  }, {
    "tStartMs": 511300,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "And she doesn't have to work for it,"
    } ]
  }, {
    "tStartMs": 512133,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "and that's not all the\nrest of her investments."
    } ]
  }, {
    "tStartMs": 514500,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "That's not from her oil, gas,"
    } ]
  }, {
    "tStartMs": 516540,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and businesses and stuff like this."
    } ]
  }, {
    "tStartMs": 518940,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Well, but that's what we talk about,"
    } ]
  }, {
    "tStartMs": 519773,
    "dDurationMs": 2307,
    "segs": [ {
      "utf8": "I mean, that's freedom, is you know,"
    } ]
  }, {
    "tStartMs": 522080,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and when you don't have to work anymore"
    } ]
  }, {
    "tStartMs": 523460,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "because you got that money\ncomin' in every month."
    } ]
  }, {
    "tStartMs": 525490,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "We talk about when we\nfirst retired was '94,"
    } ]
  }, {
    "tStartMs": 528560,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "we only had $10,000 a month\ncoming in every month."
    } ]
  }, {
    "tStartMs": 531320,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "That was it."
    } ]
  }, {
    "tStartMs": 532153,
    "dDurationMs": 2487,
    "segs": [ {
      "utf8": "But we only had $3,000 a month goin' out."
    } ]
  }, {
    "tStartMs": 534640,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "So we were free, so it's\nnot that dollar amount,"
    } ]
  }, {
    "tStartMs": 536600,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "it's can you cover your\nexpenses and be free,"
    } ]
  }, {
    "tStartMs": 539210,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "because after that, then we were able"
    } ]
  }, {
    "tStartMs": 540890,
    "dDurationMs": 2427,
    "segs": [ {
      "utf8": "to get on with what it is\nwe really wanted to do."
    } ]
  }, {
    "tStartMs": 543317,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Right."
    } ]
  }, {
    "tStartMs": 544150,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "- When most people are still busy"
    } ]
  }, {
    "tStartMs": 545570,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "working for that paycheck and, you know,"
    } ]
  }, {
    "tStartMs": 547220,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "just surviving everyday as we were,"
    } ]
  }, {
    "tStartMs": 549280,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "that they don't have time\nto really think about"
    } ]
  }, {
    "tStartMs": 550730,
    "dDurationMs": 1385,
    "segs": [ {
      "utf8": "what is it I really wanna do?"
    } ]
  }, {
    "tStartMs": 552115,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "(inspirational piano music)"
    } ]
  } ]
}
