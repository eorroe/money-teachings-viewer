  "events": [ {
    "tStartMs": 352,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 2852,
    "dDurationMs": 2575,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 5427,
    "dDurationMs": 973,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 6400,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "- Hi, Robert Kiyosaki, I'm\nhere with Alex, Alexandra,"
    } ]
  }, {
    "tStartMs": 10260,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "and we're talking about\nmillennials and money."
    } ]
  }, {
    "tStartMs": 13950,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "And so today we're\ngoing to be talking more"
    } ]
  }, {
    "tStartMs": 15860,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "about my favorite subject,"
    } ]
  }, {
    "tStartMs": 17110,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "is why I hated school so much. (chuckles)"
    } ]
  }, {
    "tStartMs": 19820,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "Because as you know we\nlearn little to nothing"
    } ]
  }, {
    "tStartMs": 23650,
    "dDurationMs": 1883,
    "segs": [ {
      "utf8": "in school, but in fact,"
    } ]
  }, {
    "tStartMs": 27059,
    "dDurationMs": 2621,
    "segs": [ {
      "utf8": "you will find out that going"
    } ]
  }, {
    "tStartMs": 29680,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "to school actually diminishes\nyour ability to get rich."
    } ]
  }, {
    "tStartMs": 34400,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "You know, so that goes counter\nto what everybody tells you."
    } ]
  }, {
    "tStartMs": 36860,
    "dDurationMs": 2843,
    "segs": [ {
      "utf8": "You to go to school, get a\njob and you'll make money."
    } ]
  }, {
    "tStartMs": 40560,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And that worked probably\na thousand years ago,"
    } ]
  }, {
    "tStartMs": 43800,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "not working today."
    } ]
  }, {
    "tStartMs": 44830,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "You know, it didn't work for me."
    } ]
  }, {
    "tStartMs": 46110,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "I mean, I have a college\ndegree, but I learned nothing"
    } ]
  }, {
    "tStartMs": 48890,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "about money."
    } ]
  }, {
    "tStartMs": 50300,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "You know, and what I've learned,"
    } ]
  }, {
    "tStartMs": 52430,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I had to learn on my own from my rich dad."
    } ]
  }, {
    "tStartMs": 55430,
    "dDurationMs": 3986,
    "segs": [ {
      "utf8": "So we're going to talking about school,"
    } ]
  }, {
    "tStartMs": 59416,
    "dDurationMs": 2254,
    "segs": [ {
      "utf8": "making mistakes,"
    } ]
  }, {
    "tStartMs": 61670,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and we're going to talk\nto you about cheating."
    } ]
  }, {
    "tStartMs": 63890,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "Okay?"
    } ]
  }, {
    "tStartMs": 64810,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Alexandra] My favorite."
    } ]
  }, {
    "tStartMs": 65643,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes, a subject."
    } ]
  }, {
    "tStartMs": 66476,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "Okay, so in school, what\ndo you have to do to cheat?"
    } ]
  }, {
    "tStartMs": 70010,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "- I'd say finding a smart person in class"
    } ]
  }, {
    "tStartMs": 71650,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and looking at their paper."
    } ]
  }, {
    "tStartMs": 73810,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "- [Robert] You see, when I\nwas in school the definition"
    } ]
  }, {
    "tStartMs": 77000,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "of cheating was, I asked\na smart girl like you."
    } ]
  }, {
    "tStartMs": 81840,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "And that's how I got\nthrough school. (chuckles)"
    } ]
  }, {
    "tStartMs": 84230,
    "dDurationMs": 3830,
    "segs": [ {
      "utf8": "I always sat next to the\nsmartest girl in my class."
    } ]
  }, {
    "tStartMs": 88060,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And the teachers kept throwing\nme out because they said,"
    } ]
  }, {
    "tStartMs": 90100,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "you're cheating."
    } ]
  }, {
    "tStartMs": 91690,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "But I would go to my rich dad, he goes,"
    } ]
  }, {
    "tStartMs": 93930,
    "dDurationMs": 2193,
    "segs": [ {
      "utf8": "that's not cheating, that's cooperation."
    } ]
  }, {
    "tStartMs": 96990,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "And so I have my poor dad,"
    } ]
  }, {
    "tStartMs": 98560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "who would have said I was cheating."
    } ]
  }, {
    "tStartMs": 100720,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "And my rich dad said I was cooperating."
    } ]
  }, {
    "tStartMs": 104820,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "There are two different points of view."
    } ]
  }, {
    "tStartMs": 106510,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "Now, there's this brand new book out,"
    } ]
  }, {
    "tStartMs": 109200,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "I'm having everybody\nthat comes today read it."
    } ]
  }, {
    "tStartMs": 110980,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "It's called Big Potential\nand it's by Shawn Achor."
    } ]
  }, {
    "tStartMs": 114950,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "Now he's not a flunky like me."
    } ]
  }, {
    "tStartMs": 117010,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "He was 12 years at Harvard as a teacher,"
    } ]
  }, {
    "tStartMs": 119160,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "and all this stuff there,"
    } ]
  }, {
    "tStartMs": 120070,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "and he studied all these students,"
    } ]
  }, {
    "tStartMs": 122340,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "and he's the one that\nfound out that the age"
    } ]
  }, {
    "tStartMs": 124570,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "of suicide is going down."
    } ]
  }, {
    "tStartMs": 126530,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Kids are committing\nsuicide at a younger age."
    } ]
  }, {
    "tStartMs": 129410,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And depression went from age 28 to 14."
    } ]
  }, {
    "tStartMs": 132530,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "And he says the reason is,\nis because how we teach kids."
    } ]
  }, {
    "tStartMs": 136040,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "So, all you school teachers\nout there, don't read this book"
    } ]
  }, {
    "tStartMs": 139230,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "because you're going to find\nout you're damaging kids."
    } ]
  }, {
    "tStartMs": 142050,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "But worst of all, you make\nit harder to get rich."
    } ]
  }, {
    "tStartMs": 145530,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "Because what he talks about here in this,"
    } ]
  }, {
    "tStartMs": 147590,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "is in school they talk\nto you about the survival"
    } ]
  }, {
    "tStartMs": 150110,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "of the fittest."
    } ]
  }, {
    "tStartMs": 151770,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "The A student."
    } ]
  }, {
    "tStartMs": 153190,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Were you an A student?"
    } ]
  }, {
    "tStartMs": 154023,
    "dDurationMs": 1347,
    "segs": [ {
      "utf8": "- No?"
    } ]
  }, {
    "tStartMs": 155370,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- I was not an A student either."
    } ]
  }, {
    "tStartMs": 157230,
    "dDurationMs": 1153,
    "segs": [ {
      "utf8": "I was a C student."
    } ]
  }, {
    "tStartMs": 159220,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "And I found out that by cheating,"
    } ]
  }, {
    "tStartMs": 161840,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I was actually preparing\nmyself to do well in business."
    } ]
  }, {
    "tStartMs": 166850,
    "dDurationMs": 1013,
    "segs": [ {
      "utf8": "What do you think about that?"
    } ]
  }, {
    "tStartMs": 167863,
    "dDurationMs": 1643,
    "segs": [ {
      "utf8": "- That's incredible."
    } ]
  }, {
    "tStartMs": 169506,
    "dDurationMs": 1104,
    "segs": [ {
      "utf8": "- So you guys read this book."
    } ]
  }, {
    "tStartMs": 170610,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "It's easy to read, it's"
    } ]
  } ]
}
