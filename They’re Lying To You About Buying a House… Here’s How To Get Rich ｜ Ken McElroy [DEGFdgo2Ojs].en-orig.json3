      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 49360,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "to lead with the younger generation,\nwhat would that be?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 55840,
    "dDurationMs": 5359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "What's going on everyone and welcome\nback to the School of Hard Knocks",
