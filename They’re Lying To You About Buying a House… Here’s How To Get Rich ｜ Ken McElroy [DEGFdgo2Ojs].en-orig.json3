    "tStartMs": 5759,
    "dDurationMs": 5201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "worth of real estate, you definitely\nlearn a thing or two about taxes.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8800,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e The reason why I like real estate is the\nbonus depreciation, [music] the straight",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 12320,
