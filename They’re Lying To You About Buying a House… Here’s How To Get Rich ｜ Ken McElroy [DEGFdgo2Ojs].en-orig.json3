    } ]
  }, {
    "tStartMs": 32880,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Sure. Well, the first thing I would do\nis what's the biggest life lesson that",
