    } ]
  }, {
    "tStartMs": 46239,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e Ken, if me and you died tomorrow and you\nhad one [music] more guiding principle",
